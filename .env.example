# NeighbourPulse Environment Variables
# Copy to .env and replace with your real credentials if using Supabase & Mapbox

# Supabase configuration (optional if VITE_DEMO_MODE=true)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Mapbox Access Token (optional - app falls back to interactive list/mock map if omitted)
VITE_MAPBOX_ACCESS_TOKEN=

# Enable Demo Mode (runs offline with mock database and persona switcher)
VITE_DEMO_MODE=true

